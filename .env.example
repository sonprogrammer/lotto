# MongoDB 연결 정보 (서버 전용)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
MONGODB_DB_NAME=lotto

# Kakao Developers 앱의 REST API 키와 Client Secret (서버 전용)
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# Kakao Developers에 등록한 콜백 경로. 현재 배포 주소는 서버가 붙입니다.
KAKAO_REDIRECT_URI=/api/auth/kakao/callback
